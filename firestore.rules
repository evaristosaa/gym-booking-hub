rules_version = '2';

// The PWA never talks to Firestore directly. All user data and encrypted
// connection material travel through the Cloud Run API after token validation.
// Firebase Admin on Cloud Run bypasses these rules; browsers do not.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
